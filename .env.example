# Copy to .env and fill in real values. .env is gitignored - never commit real secrets.
DB_USERNAME=auth_service
DB_PASSWORD=change-me
JWT_HMAC_SECRET=change-me-to-a-random-256-bit-value
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Social login - leave blank to run without social login (signup/login/etc. still work)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OAUTH2_FRONTEND_REDIRECT_URI=http://localhost:3000/oauth2/callback
